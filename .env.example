# --- PostgreSQL (base EXTERNE, créée sur le serveur) ---
POSTGRES_DB=portfolio
POSTGRES_USER=portfoliouser
POSTGRES_PASSWORD=1SX8WSfPPOS9E0Bn6S3
# POSTGRES_HOST :
#   - BD tournant sur l'hôte             -> host.docker.internal
#   - BD conteneurisée sur le réseau net -> nom du conteneur postgres (ex: shared-db)
POSTGRES_HOST=host.docker.internal #172.17.0.1
POSTGRES_PORT=5432

# --- Email (contact notifications) ---
# Leave the default console backend for local dev (prints emails to logs).
# For prod, use SMTP (e.g. Resend, SendGrid, Gmail app password):
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
